{
  "name": "llm-api-doctor-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop client for LLM API Doctor.",
  "author": "LLM API Doctor contributors",
  "main": "out/main/index.js",
  "scripts": {
    "build:core": "npm --prefix .. run build",
    "dev": "npm run build:core && electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:core && electron-vite build",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:win:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
